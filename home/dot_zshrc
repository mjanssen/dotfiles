export PATH="$HOME/.bun/bin:$HOME/.local/bin:/opt/homebrew/bin:$PATH"

export XDG_CONFIG_HOME="$HOME/.config"
export BUN_INSTALL="$HOME/.bun"

PS1="%m: %~ %% "

alias k="kubectl"

[ -s "$HOME/.bun/_bun" ] && source "$HOME/.bun/_bun"

# K8s autocomplete
autoload -Uz compinit
compinit
source <(kubectl completion zsh)

[[ -f ~/.zshrc.local ]] && source ~/.zshrc.local

# bun completions
[ -s "/Users/mjanssen/.bun/_bun" ] && source "/Users/mjanssen/.bun/_bun"

# seperate claude-code setups
claude() {
  echo "Use claude-work or claude-personal instead." >&2
  return 1
}

claude-work()     { CLAUDE_CONFIG_DIR="$HOME/.claude-work"     command claude "$@"; }
claude-personal() { CLAUDE_CONFIG_DIR="$HOME/.claude-personal" command claude "$@"; }

